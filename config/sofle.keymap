#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Fast page scrolling encoder behavior - sends 20 page commands per rotation (inverted)

        fast_pg_encoder: fast_pg_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&fast_pg_dn>, <&fast_pg_up>;

            // Inverted: CW = down, CCW = up
        };

        // Fast page up macro - sends 20 PG_UP commands

        fast_pg_up: fast_pg_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP &kp PG_UP>;
        };

        // Fast page down macro - sends 20 PG_DN commands

        fast_pg_dn: fast_pg_dn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN &kp PG_DN>;
        };

        login: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(D) &kp I &kp E &kp L &kp S &kp A &kp L &kp D &kp E &kp R &kp N6 &kp N9 &kp EXCL>;
            label = "NEW_MACRO";
        };
    };
};

// Soft Off: used on the encoder push-buttons on LOWER and ADJUST only.
// A short press is sufficient; the wake-up source is configured in the
// nice!nano overlay so the same encoder button can wake the keyboard.
&soft_off {
    hold-time-ms = <0>;
};

#

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        plus {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Sofle";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1!  |  2@  |  3#  |  4$  |  5%  |                   |  6^  |  7&   |  8*   |  9(  |   0)  |   -_  |
            // |  TAB  |  Q   |  W   |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // | SHIFT |  A   |  S   |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;:  |   '"  |
            // | CTRL  |  Z   |  X   |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,<   |  .>  |   /?  |   \|  |
            //                | GUI  | ALT  | CTRL | LOWER|  SPACE |  | ENTER | RAISE|  ALT  | CTRL  | GUI  |

            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3    &kp N4            &kp N5                              &kp N6  &kp N7      &kp N8     &kp N9    &kp N0     &kp MINUS
&kp TAB    &kp Q   &kp W     &kp E     &kp R             &kp T                               &kp Y   &kp U       &kp I      &kp O     &kp P      &kp BSPC
&kp LSHFT  &kp A   &kp S     &kp D     &kp F             &kp G                               &kp H   &kp J       &kp K      &kp L     &kp SEMI   &kp SQT
&kp LCTRL  &kp Z   &kp X     &kp C     &kp V             &kp B   &kp C_MUTE    &kp CAPSLOCK  &kp N   &kp M       &kp COMMA  &kp DOT   &kp SLASH  &kp BSLH
                   &kp LGUI  &kp LALT  &kp LEFT_CONTROL  &mo 1   &kp SPACE     &kp ENTER     &mo 2   &sk LSHIFT  &kp RCTRL  &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOLUME_UP>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        lower_layer {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // | LGUI  |     | up  |      | RGB  |modRGB|                   |      |  1    |  2    |  3   |  PGUP |  PGDN |
            // | ESC   |  L  | dn  |  R   | hue- | hue+ |                   |      |  4    |  5    |  6   |  HOME |  END  |
            // | PSCRN |ZMKST|     |      | Bri- | Bri+ |        |  |       |      |  7    |  8    |  9   |       |ZMKSTUD|
            //               | mo2 | alt  | SHF  | DEL  |  BSPC  |  | ENTER | SPACE|       |  0    |      |

            bindings = <
&kp ESC    &kp F1          &kp F2    &kp F3     &kp F4           &kp F5                                         &kp F6    &kp F7  &kp F8  &kp F9  &kp F10   &kp F11
&kp LGUI   &trans          &kp UP    &trans     &rgb_ug RGB_TOG  &rgb_ug RGB_EFF                                &kp HOME  &kp N1  &kp N2  &kp N3  &kp HOME  &kp F12
&kp ESC    &kp LEFT        &kp DOWN  &kp RIGHT  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI                                &kp END   &kp N4  &kp N5  &kp N6  &kp END   &kp CLEAR
&kp PSCRN  &studio_unlock  &trans    &trans     &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &soft_off   &soft_off        &trans    &kp N7  &kp N8  &kp N9  &trans    &studio_unlock
                           &mo 2     &kp LALT   &kp LSHFT        &mo 1            &kp BSPC    &kp ENTER         &trans    &trans  &kp N0  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp LEFT RIGHT>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &login     &trans    &trans    &trans     &trans   &trans
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans                                 &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                               &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans           &trans  &trans     &trans    &trans    &trans     &trans   &trans
                          &trans        &trans        &trans        &kp DELETE    &kp BACKSPACE    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_DN PG_UP &fast_pg_encoder>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // |        | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &none  &none  &none  &none  &none  &none
&trans      &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none       &none            &none            &none            &none            &none            &soft_off        &soft_off  &none  &none  &none  &none  &none  &none
                             &none            &none            &none            &none            &none              &none  &none  &none  &none  &none
            >;
        };
    };
};
